VITE_API_BASE_URL=http://localhost:3000/api/v1

# Used only at BUILD time by scripts/generate-sitemap.mjs and
# scripts/prerender-products.mjs to fetch live product/category data for
# sitemap.xml and the per-product prerendered SEO shells. Point this at the
# real production API (not localhost) in Render's build environment. Falls
# back to VITE_API_BASE_URL if unset.
SITEMAP_API_BASE_URL=

# Firebase (Google Sign-In)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Web Push — public VAPID key (must match the backend's VAPID_PUBLIC_KEY)
VITE_VAPID_PUBLIC_KEY=
